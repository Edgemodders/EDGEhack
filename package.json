{
  "name": "edgehack",
  "displayName": "EDGEhack",
  "description": "Quickhack editor for Cyberpunk 2077: open any quickhack, change its name, icon, costs and effects, or make a new one from the game's own status effects.",
  "version": "0.0.26",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "docs/assets/brand/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEhack"
  },
  "homepage": "https://edgemodders.github.io/EDGEhack/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEhack/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk 2077",
    "quickhacks",
    "tweakdb",
    "tweakxl",
    "modding",
    "edgehack"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgehack",
          "title": "EDGEhack",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgehack": [
        {
          "id": "edgehack.desk",
          "name": "Desk"
        },
        {
          "id": "edgehack.library",
          "name": "Library"
        },
        {
          "id": "edgehack.quickhacks",
          "name": "Quickhacks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgehack.desk",
        "contents": "Quickhacks you work on outside a project wait here, until you add them to one.\n[Clone and Modify on the Desk](command:edgehack.desk.new)\nWith no project open in REDcode, Clone and Modify and Edit in the Quickhacks view land here too."
      },
      {
        "view": "edgehack.library",
        "contents": "Quickhacks in your EDGE Library. Coming in H5."
      }
    ],
    "commands": [
      {
        "command": "edgehack.openQuickhack",
        "title": "Open a Quickhack...",
        "category": "EDGEhack",
        "icon": "$(go-to-file)"
      },
      {
        "command": "edgehack.openQuickhackFromREDcode",
        "title": "Open in EDGEhack",
        "category": "EDGEhack"
      },
      {
        "command": "edgehack.quickhacks.filter",
        "title": "Filter",
        "category": "EDGEhack",
        "icon": "$(filter)"
      },
      {
        "command": "edgehack.quickhacks.clearFilter",
        "title": "Clear the Filter",
        "category": "EDGEhack",
        "icon": "$(clear-all)"
      },
      {
        "command": "edgehack.quickhacks.refresh",
        "title": "Refresh",
        "category": "EDGEhack",
        "icon": "$(refresh)"
      },
      {
        "command": "edgehack.openInREDcode",
        "title": "Open the Record in REDcode",
        "category": "EDGEhack"
      },
      {
        "command": "edgehack.editQuickhack",
        "title": "Edit",
        "category": "EDGEhack"
      },
      {
        "command": "edgehack.newQuickhack",
        "title": "Clone and Modify...",
        "category": "EDGEhack"
      },
      {
        "command": "edgehack.desk.new",
        "title": "Clone and Modify on the Desk...",
        "category": "EDGEhack",
        "icon": "$(add)"
      },
      {
        "command": "edgehack.desk.addToProject",
        "title": "Add to Project",
        "category": "EDGEhack",
        "icon": "$(new-file)"
      },
      {
        "command": "edgehack.desk.duplicate",
        "title": "Duplicate...",
        "category": "EDGEhack"
      },
      {
        "command": "edgehack.desk.remove",
        "title": "Remove from the Desk...",
        "category": "EDGEhack",
        "icon": "$(trash)"
      },
      {
        "command": "edgehack.project.remove",
        "title": "Remove from Project...",
        "category": "EDGEhack",
        "icon": "$(trash)"
      },
      {
        "command": "edgehack.setOpenAIKey",
        "title": "Set the OpenAI Key...",
        "category": "EDGEhack"
      },
      {
        "command": "edgehack.clearOpenAIKey",
        "title": "Clear the OpenAI Key...",
        "category": "EDGEhack"
      }
    ],
    "configuration": {
      "title": "EDGEhack",
      "properties": {
        "edgehack.generate.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "The OpenAI model Generate uses for icons. Empty: the newest GPT Image model (`gpt-image...`) your key's account lists."
        },
        "edgehack.generate.quality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "auto"
          ],
          "default": "medium",
          "markdownDescription": "The quality Generate asks OpenAI for. Higher costs more per image."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "edgehack.desk.new",
          "when": "view == edgehack.desk",
          "group": "navigation@1"
        },
        {
          "command": "edgehack.quickhacks.filter",
          "when": "view == edgehack.quickhacks && !edgehack.quickhacksFiltered",
          "group": "navigation@1"
        },
        {
          "command": "edgehack.quickhacks.clearFilter",
          "when": "view == edgehack.quickhacks && edgehack.quickhacksFiltered",
          "group": "navigation@1"
        },
        {
          "command": "edgehack.quickhacks.refresh",
          "when": "view == edgehack.quickhacks",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "edgehack.newQuickhack",
          "when": "view == edgehack.quickhacks && viewItem =~ /^edgehack\\.(family|tier)$/",
          "group": "navigation@0"
        },
        {
          "command": "edgehack.openInREDcode",
          "when": "view == edgehack.quickhacks && viewItem =~ /^edgehack\\.(family|tier|action)$/",
          "group": "navigation@1"
        },
        {
          "command": "edgehack.openQuickhackFromREDcode",
          "when": "view == redcode.tweakdb && viewItem == tweakRecord",
          "group": "navigation@9"
        },
        {
          "command": "edgehack.desk.addToProject",
          "when": "view == edgehack.desk && viewItem =~ /^edgehack\\.desk\\.(new|change)$/",
          "group": "inline@1"
        },
        {
          "command": "edgehack.desk.addToProject",
          "when": "view == edgehack.desk && viewItem =~ /^edgehack\\.desk\\.(new|change)$/",
          "group": "navigation@1"
        },
        {
          "command": "edgehack.desk.duplicate",
          "when": "view == edgehack.desk && viewItem == edgehack.desk.new",
          "group": "navigation@2"
        },
        {
          "command": "edgehack.desk.remove",
          "when": "view == edgehack.desk && viewItem =~ /^edgehack\\.desk\\./",
          "group": "inline@9"
        },
        {
          "command": "edgehack.desk.remove",
          "when": "view == edgehack.desk && viewItem =~ /^edgehack\\.desk\\./",
          "group": "z@9"
        },
        {
          "command": "edgehack.project.remove",
          "when": "view == edgehack.desk && viewItem =~ /^edgehack\\.doc\\./",
          "group": "inline@9"
        },
        {
          "command": "edgehack.project.remove",
          "when": "view == edgehack.desk && viewItem =~ /^edgehack\\.doc\\./",
          "group": "z@9"
        }
      ],
      "commandPalette": [
        {
          "command": "edgehack.newQuickhack",
          "when": "false"
        },
        {
          "command": "edgehack.openQuickhackFromREDcode",
          "when": "false"
        },
        {
          "command": "edgehack.openInREDcode",
          "when": "false"
        },
        {
          "command": "edgehack.quickhacks.clearFilter",
          "when": "edgehack.quickhacksFiltered"
        },
        {
          "command": "edgehack.editQuickhack",
          "when": "false"
        },
        {
          "command": "edgehack.desk.addToProject",
          "when": "false"
        },
        {
          "command": "edgehack.desk.duplicate",
          "when": "false"
        },
        {
          "command": "edgehack.desk.remove",
          "when": "false"
        },
        {
          "command": "edgehack.project.remove",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "edgehack.quickhack.editor",
        "displayName": "EDGEhack Quickhack",
        "selector": [
          {
            "filenamePattern": "*.quickhack.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "nexus-zip": "node tools/nexus-zip.mjs",
    "nexus:pull": "node ../EDGErepo/tools/nexus/nexus.mjs pull",
    "nexus:status": "node ../EDGErepo/tools/nexus/nexus.mjs status",
    "release:notes": "node tools/release-notes.mjs",
    "smoke": "node tools/smoke/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "~5.9.3"
  },
  "extensionDependencies": [
    "edgemodders.redcode-cyberpunk"
  ]
}
