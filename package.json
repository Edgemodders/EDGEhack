{
  "name": "edgehack",
  "displayName": "EDGEhack",
  "description": "Quickhack editor for Cyberpunk 2077: open any quickhack, change its name, icon, costs and effects, or make a new one from the game's own status effects.",
  "version": "0.0.1",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "docs/assets/brand/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEhack"
  },
  "homepage": "https://edgemodders.github.io/EDGEhack/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEhack/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk 2077",
    "quickhacks",
    "tweakdb",
    "tweakxl",
    "modding",
    "edgehack"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgehack",
          "title": "EDGEhack",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgehack": [
        {
          "id": "edgehack.desk",
          "name": "Desk"
        },
        {
          "id": "edgehack.library",
          "name": "Library"
        },
        {
          "id": "edgehack.quickhacks",
          "name": "Quickhacks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgehack.desk",
        "contents": "Quickhacks you are working on wait here until they go into a project. Coming in H2 and H3.\n[Read the design](https://edgemodders.github.io/EDGEhack/design.html)"
      },
      {
        "view": "edgehack.library",
        "contents": "Quickhacks in your EDGE Library. Coming in H5."
      },
      {
        "view": "edgehack.quickhacks",
        "contents": "The game's quickhacks, by category, family and tier. Coming in H1."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "nexus-zip": "node tools/nexus-zip.mjs",
    "nexus:pull": "node tools/nexus/nexus.mjs pull",
    "nexus:status": "node tools/nexus/nexus.mjs status",
    "release:notes": "node tools/release-notes.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
